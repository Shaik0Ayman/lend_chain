{
  "name": "LendChain (Hyperledger Fabric P2P lending)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "4gb", "storage": "16gb" },
  "forwardPorts": [4001, 4002, 4003],
  "portsAttributes": {
    "4001": { "label": "LendChain platform (borrowers / lenders / operator)", "onAutoForward": "notify" },
    "4002": { "label": "Trustee bank console (simulated money)", "onAutoForward": "silent" },
    "4003": { "label": "Auditor portal (read-only ledger)", "onAutoForward": "silent" }
  },
  "postStartCommand": "./lendchain.sh start",
  "customizations": {
    "vscode": { "settings": { "terminal.integrated.defaultProfile.linux": "bash" } }
  }
}
